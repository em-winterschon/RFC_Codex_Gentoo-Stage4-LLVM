# Shared ntfy transport
NTFY_URL=http://msg-sun99-ntfysys.rfc1918.host
NTFY_TOPIC=replace-with-your-topic
# NTFY_ALERT_TOPIC=replace-with-your-alert-topic
# NTFY_REPLY_TOPIC=replace-with-your-reply-topic
# NTFY_TOKEN=
# NTFY_USERNAME=
# NTFY_PASSWORD=
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional per-state topics
# NTFY_TOPIC_SUCCESS=replace-with-your-success-topic
# NTFY_TOPIC_FAIL=replace-with-your-failure-topic
# NTFY_TOPIC_ERROR=replace-with-your-error-topic
# NTFY_TOPIC_WARNING=replace-with-your-warning-topic

# Ansible callback/action plugin settings
ANSIBLE_NTFY_ENABLED=true
ANSIBLE_NTFY_URL=http://msg-sun99-ntfysys.rfc1918.host
ANSIBLE_NTFY_TOPIC=replace-with-your-topic
# ANSIBLE_NTFY_TOPIC_SUCCESS=replace-with-your-success-topic
# ANSIBLE_NTFY_TOPIC_FAIL=replace-with-your-failure-topic
# ANSIBLE_NTFY_TOPIC_ERROR=replace-with-your-error-topic
# ANSIBLE_NTFY_TOPIC_WARNING=replace-with-your-warning-topic
# ANSIBLE_NTFY_TOKEN=

# Codex/local operation settings
# CODEX_NTFY_ENV_FILE=/root/.codex/ntfy-pub-subs.export.sh
CODEX_NTFY_URL=http://msg-sun99-ntfysys.rfc1918.host
CODEX_NTFY_TOPIC=replace-with-your-topic
# CODEX_NTFY_ALERT_TOPIC=replace-with-your-alert-topic
# CODEX_NTFY_REPLY_TOPIC=replace-with-your-reply-topic
# CODEX_NTFY_TOKEN=
# CODEX_NTFY_WAIT_SECS=300
# CODEX_NTFY_TOPIC_ACTION_REQUIRED=replace-with-your-action-topic
# CODEX_NTFY_REPLY_QUEUE_DIR=/root/.codex/ntfy-replies
# CODEX_NTFY_REPLY_LISTENER_STATE_FILE=/root/.codex/ntfy-reply-listener-state.json
# CODEX_NTFY_POLICY_FILE=/root/.codex/ntfy-policy.json
