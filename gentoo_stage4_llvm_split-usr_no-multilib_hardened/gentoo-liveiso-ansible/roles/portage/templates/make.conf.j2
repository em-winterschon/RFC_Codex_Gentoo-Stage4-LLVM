# Generated by gentoo-liveiso-ansible
COMMON_FLAGS="-O2 -pipe -march={{ selected_cpu_profile.march }} -mtune={{ selected_cpu_profile.tune }}"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"
LDFLAGS="-Wl,-O2 -Wl,--as-needed -fuse-ld=lld"
RUSTFLAGS="-C target-cpu={{ selected_cpu_profile.rust_target_cpu }}"

CHOST="x86_64-pc-linux-gnu"
GRUB_PLATFORMS="efi-64"
MAKEOPTS="-j{{ portage_makeopts_jobs }}"
EMERGE_DEFAULT_OPTS="--jobs={{ portage_emerge_jobs }}{% if portage_load_average | int > 0 %} --load-average={{ portage_load_average }}{% endif %}"
ACCEPT_LICENSE="{{ portage_accept_license }}"
FEATURES="{{ portage_features | join(' ') }}"
LLVM_TARGETS="{{ selected_cpu_profile.llvm_targets }}"
VIDEO_CARDS="{{ selected_gpu_profile.video_cards }}"
USE="{{ (portage_global_use + selected_gpu_profile.extra_use + portage_extra_use) | unique | join(' ') }}"

CC="clang"
CXX="clang++"
AR="llvm-ar"
NM="llvm-nm"
RANLIB="llvm-ranlib"

{% if cpu_flags_x86_override | length > 0 -%}
CPU_FLAGS_X86="{{ cpu_flags_x86_override | join(' ') }}"
{% endif -%}
