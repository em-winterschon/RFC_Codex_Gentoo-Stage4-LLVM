# Generated by gentoo-liveiso-ansible
COMMON_FLAGS="-O2 -pipe -march={{ selected_cpu_profile.march }} -mtune={{ selected_cpu_profile.tune }}"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"
LDFLAGS="-Wl,-O2 -Wl,--as-needed -fuse-ld=lld"
RUSTFLAGS="-C target-cpu={{ selected_cpu_profile.rust_target_cpu }}"

CHOST="x86_64-pc-linux-gnu"
GRUB_PLATFORMS="efi-64"
MAKEOPTS="-j{{ portage_makeopts_jobs }}"
{% set binpkg_opts = [] %}
{% if portage_buildpkg_enabled | default(false) | bool %}
{% set _ = binpkg_opts.extend(['--buildpkg=y', '--with-bdeps=y', '--complete-graph=y', '--binpkg-respect-use=y']) %}
{% endif %}
{% if portage_getbinpkg_enabled | default(false) | bool %}
{% set _ = binpkg_opts.append('--getbinpkg=y') %}
{% endif %}
{% if portage_usepkg_enabled | default(false) | bool %}
{% set _ = binpkg_opts.append('--usepkg=y') %}
{% endif %}
{% set explicit_extra_opts = portage_emerge_default_opts_extra | default([]) %}
EMERGE_DEFAULT_OPTS="--jobs={{ portage_emerge_jobs }}{% if portage_load_average | int > 0 %} --load-average={{ portage_load_average }}{% endif %}{% if binpkg_opts | length > 0 %} {{ binpkg_opts | unique | join(' ') }}{% endif %}{% if explicit_extra_opts | length > 0 %} {{ explicit_extra_opts | join(' ') }}{% endif %}"
ACCEPT_LICENSE="{{ portage_accept_license }}"
{% set resolved_features = portage_features | default([]) %}
{% if portage_buildpkg_enabled | default(false) | bool %}
{% set resolved_features = (resolved_features + ['buildpkg']) | unique %}
{% endif %}
FEATURES="{{ resolved_features | join(' ') }}"
{% if portage_pkgdir | default('') | length > 0 %}
PKGDIR="{{ portage_pkgdir }}"
{% endif %}
PORTAGE_BINPKG_FORMAT="{{ portage_binpkg_format | default('tar') }}"
BINPKG_COMPRESS="{{ portage_binpkg_compress | default('zstd') }}"
BINPKG_COMPRESS_FLAGS="{{ portage_binpkg_compress_flags | default('-2') }}"
{% if portage_binhost | default('') | length > 0 %}
BINHOST="{{ portage_binhost }}"
{% endif %}
LLVM_TARGETS="{{ selected_cpu_profile.llvm_targets }}"
{% if selected_gpu_profile.video_cards | length > 0 -%}
VIDEO_CARDS="{{ selected_gpu_profile.video_cards }}"
{% endif -%}
USE="{{ (portage_global_use + selected_gpu_profile.extra_use + portage_extra_use) | unique | join(' ') }}"

CC="clang"
CXX="clang++"
AR="llvm-ar"
NM="llvm-nm"
RANLIB="llvm-ranlib"

{% set resolved_cpu_flags_x86 = cpu_flags_x86_override | default(selected_cpu_profile.cpu_flags_x86_override | default([])) %}
{% if resolved_cpu_flags_x86 | length > 0 -%}
CPU_FLAGS_X86="{{ resolved_cpu_flags_x86 | join(' ') }}"
{% endif -%}
{% if resolved_portage_make_conf_append | default('') | trim | length > 0 %}

{{ resolved_portage_make_conf_append | trim | replace('\\n', '\n') }}
{% endif -%}
