# RouterOS Path B lab configuration
# Generated by Ansible role: routeros_pathb
# UEFI-only policy: {{ routeros_pathb_boot_mode }}
# Future HA mode target: {{ routeros_pathb_ha_mode }}{% if routeros_pathb_ha_peer %} (peer={{ routeros_pathb_ha_peer }}){% endif %}

/system identity set name="{{ routeros_pathb_identity }}"
/system note set show-at-login=yes note="Managed by RFC Codex Path B role; UEFI-only netboot lab."
/system clock set time-zone-name="{{ routeros_pathb_timezone }}"

# Base interfaces, L3 addresses, and DHCP scope for the Path B lab.
{% if routeros_pathb_lan_default_name != routeros_pathb_lan_interface %}
:if ([:len [/interface ethernet find where default-name="{{ routeros_pathb_lan_default_name }}"]] > 0) do={ /interface ethernet set [find default-name="{{ routeros_pathb_lan_default_name }}"] name="{{ routeros_pathb_lan_interface }}" }
{% endif %}
{% if routeros_pathb_wan_enabled | bool and routeros_pathb_wan_default_name != routeros_pathb_wan_interface %}
:if ([:len [/interface ethernet find where default-name="{{ routeros_pathb_wan_default_name }}"]] > 0) do={ /interface ethernet set [find default-name="{{ routeros_pathb_wan_default_name }}"] name="{{ routeros_pathb_wan_interface }}" }
{% endif %}
{% if routeros_pathb_disable_dhcp_clients | bool %}
/ip dhcp-client remove [find]
{% endif %}
/ip address remove [find comment="{{ routeros_pathb_lab_name }}"]
/ip address add address={{ routeros_pathb_lan_cidr }} interface={{ routeros_pathb_lan_interface }} comment="{{ routeros_pathb_lab_name }}"
{% if routeros_pathb_wan_enabled | bool %}
/ip address remove [find comment="{{ routeros_pathb_lab_name }}-wan"]
/ip address add address={{ routeros_pathb_wan_cidr }} interface={{ routeros_pathb_wan_interface }} comment="{{ routeros_pathb_lab_name }}-wan"
/ip route remove [find comment="{{ routeros_pathb_lab_name }}-default"]
/ip route add dst-address=0.0.0.0/0 gateway={{ routeros_pathb_wan_gateway }} distance={{ routeros_pathb_wan_route_distance }} comment="{{ routeros_pathb_lab_name }}-default"
{% endif %}
/ip dns set servers={{ routeros_pathb_dns_servers | join(',') }} allow-remote-requests={{ routeros_pathb_dns_allow_remote_requests | ternary("yes", "no") }}
/ip pool remove [find name="{{ routeros_pathb_dhcp_pool_name }}"]
/ip pool add name="{{ routeros_pathb_dhcp_pool_name }}" ranges={{ routeros_pathb_dhcp_pool_ranges | join(',') }}
/ip dhcp-server remove [find name="{{ routeros_pathb_dhcp_server_name }}"]
/ip dhcp-server add name="{{ routeros_pathb_dhcp_server_name }}" interface={{ routeros_pathb_lan_interface }} address-pool={{ routeros_pathb_dhcp_pool_name }} lease-time={{ routeros_pathb_dhcp_lease_time }} disabled=no
/ip dhcp-server network remove [find comment="{{ routeros_pathb_lab_name }}"]
/ip dhcp-server network add address={{ routeros_pathb_lan_network_cidr }} gateway={{ routeros_pathb_gateway }} dns-server={{ routeros_pathb_dhcp_dns_servers | join(',') }} next-server={{ routeros_pathb_boot_next_server }} boot-file-name="{{ routeros_pathb_boot_file_name }}" comment="{{ routeros_pathb_lab_name }}"
{% if routeros_pathb_nat_enabled | bool %}
/ip firewall nat remove [find comment="{{ routeros_pathb_nat_comment }}"]
/ip firewall nat add chain=srcnat src-address={{ routeros_pathb_lan_network_cidr }} out-interface={{ routeros_pathb_wan_interface }} action=masquerade comment="{{ routeros_pathb_nat_comment }}"
{% endif %}
{% if routeros_pathb_firewall_baseline_enabled | bool %}
/ip firewall filter remove [find comment~"{{ routeros_pathb_firewall_comment_prefix }}-"]
/ip firewall filter add chain=input action=accept connection-state=established,related,untracked comment="{{ routeros_pathb_firewall_comment_prefix }}-input-established"
/ip firewall filter add chain=input action=drop connection-state=invalid comment="{{ routeros_pathb_firewall_comment_prefix }}-input-drop-invalid"
/ip firewall filter add chain=input action=accept protocol=icmp comment="{{ routeros_pathb_firewall_comment_prefix }}-input-icmp"
/ip firewall filter add chain=input action=accept in-interface={{ routeros_pathb_lan_interface }} comment="{{ routeros_pathb_firewall_comment_prefix }}-input-lan"
/ip firewall filter add chain=input action=drop in-interface={{ routeros_pathb_wan_interface }} comment="{{ routeros_pathb_firewall_comment_prefix }}-input-drop-wan"
/ip firewall filter add chain=forward action=accept connection-state=established,related,untracked comment="{{ routeros_pathb_firewall_comment_prefix }}-forward-established"
/ip firewall filter add chain=forward action=drop connection-state=invalid comment="{{ routeros_pathb_firewall_comment_prefix }}-forward-drop-invalid"
/ip firewall filter add chain=forward action=accept in-interface={{ routeros_pathb_lan_interface }} out-interface={{ routeros_pathb_wan_interface }} comment="{{ routeros_pathb_firewall_comment_prefix }}-forward-lan-wan"
/ip firewall filter add chain=forward action=accept in-interface={{ routeros_pathb_wan_interface }} out-interface={{ routeros_pathb_lan_interface }} connection-nat-state=dstnat comment="{{ routeros_pathb_firewall_comment_prefix }}-forward-dstnat"
/ip firewall filter add chain=forward action=drop in-interface={{ routeros_pathb_wan_interface }} comment="{{ routeros_pathb_firewall_comment_prefix }}-forward-drop-wan"
{% endif %}

# UEFI-only Path B policy: no legacy BIOS boot chain is configured.
:log info "Path B is configured for UEFI HTTP/iPXE only; legacy BIOS is unsupported."

# Management-plane services.
/ip service set telnet disabled=yes
/ip service set ftp disabled=yes
/ip service set api disabled=yes
/ip service set api-ssl disabled=yes
/ip service set ssh disabled={{ (not routeros_pathb_ssh_enabled) | ternary("yes", "no") }} port={{ routeros_pathb_ssh_port }} address={{ routeros_pathb_management_cidrs | join(',') }}
/ip ssh set strong-crypto={{ routeros_pathb_ssh_strong_crypto | ternary("yes", "no") }} forwarding-enabled={{ routeros_pathb_ssh_forwarding | bool | ternary("yes", "no") }}
/ip service set winbox disabled={{ (not routeros_pathb_winbox_enabled) | ternary("yes", "no") }} port={{ routeros_pathb_winbox_port }} address={{ routeros_pathb_management_cidrs | join(',') }}

# RouterOS native practice here is to disable plain HTTP and enable HTTPS.
# A strict redirect can be layered later via explicit proxy/container logic if required.
/ip service set www disabled={{ (not routeros_pathb_http_enabled) | ternary("yes", "no") }} port={{ routeros_pathb_http_port }}
/ip service set www-ssl disabled={{ (not routeros_pathb_https_enabled) | ternary("yes", "no") }} port={{ routeros_pathb_https_port }} address={{ routeros_pathb_management_cidrs | join(',') }}
{% if routeros_pathb_http_redirect_strategy == 'disable-http' %}
:log info "HTTP redirect strategy is disable-http; plain HTTP is disabled rather than redirected."
{% endif %}

# Self-signed certificate for HTTPS management.
/ip service set www-ssl disabled=yes certificate=none
/certificate remove [find name~"{{ routeros_pathb_certificate_name }}"]
/certificate add name="{{ routeros_pathb_certificate_name }}-template" common-name="{{ routeros_pathb_certificate_common_name }}" key-size=4096 days-valid=3650 key-usage=digital-signature,key-encipherment,tls-server,key-cert-sign,crl-sign trusted=yes
/certificate sign "{{ routeros_pathb_certificate_name }}-template" name="{{ routeros_pathb_certificate_name }}"
:delay 2s
/ip service set www-ssl certificate={{ routeros_pathb_certificate_name }}

# Time service.
/system ntp client set enabled={{ routeros_pathb_ntp_client_enabled | ternary("yes", "no") }} mode={{ routeros_pathb_ntp_client_mode }} servers={{ routeros_pathb_ntp_client_servers | join(',') }}
/system ntp server set enabled={{ routeros_pathb_ntp_server_enabled | ternary("yes", "no") }} broadcast={{ routeros_pathb_ntp_server_broadcast | ternary("yes", "no") }} multicast={{ routeros_pathb_ntp_server_multicast | ternary("yes", "no") }} broadcast-addresses={{ routeros_pathb_ntp_server_broadcast_addresses | join(',') }}

# Remote syslog client.
/system logging remove [find where action="remote"]
/system logging remove [find where action="pathb-remote-udp"]
/system logging action remove [find name="pathb-remote-udp"]
/system logging action set remote remote={{ routeros_pathb_syslog_remote_host }} remote-port={{ routeros_pathb_syslog_remote_port_udp }} remote-protocol=udp syslog-time-format=bsd-syslog
{% for routeros_log_topic in routeros_pathb_syslog_topics %}
/system logging add action=remote topics={{ routeros_log_topic }}
{% endfor %}
:log warning "RouterOS BSD-syslog remote logging uses UDP. TCP/TLS remote logging only applies to CEF format, not native syslog."

# Native RouterOS syslog server note:
:log warning "{{ routeros_pathb_syslog_server_note }}"

# SNMP exposure.
/snmp set enabled={{ routeros_pathb_snmp_enabled | ternary("yes", "no") }} contact="{{ routeros_pathb_snmp_contact }}" location="{{ routeros_pathb_snmp_location }}"
{% if routeros_pathb_snmp_disable_public %}
:if ([:len [/snmp community find where name="public"]] > 0) do={ /snmp community set [find name="public"] disabled=yes addresses={{ routeros_pathb_management_cidrs | join(',') }} }
{% endif %}
{% if routeros_pathb_snmp_v2c_enabled %}
/snmp community remove [find name="{{ routeros_pathb_snmp_v2c_community }}"]
/snmp community add name="{{ routeros_pathb_snmp_v2c_community }}" address={{ routeros_pathb_snmp_v2c_addresses | join(',') }} read-access=yes write-access={{ routeros_pathb_snmp_v2c_write_access | ternary("yes", "no") }} security=none
{% endif %}
{% if routeros_pathb_snmp_v3_enabled %}
/snmp community remove [find name="{{ routeros_pathb_snmp_v3_name }}"]
/snmp community add name="{{ routeros_pathb_snmp_v3_name }}" address={{ routeros_pathb_snmp_v2c_addresses | join(',') }} read-access=yes write-access={{ routeros_pathb_snmp_v3_write_access | ternary("yes", "no") }} security=private authentication-protocol={{ routeros_pathb_snmp_v3_auth_protocol }} authentication-password="{{ routeros_pathb_snmp_v3_auth_password }}" encryption-protocol={{ routeros_pathb_snmp_v3_priv_protocol }} encryption-password="{{ routeros_pathb_snmp_v3_priv_password }}"
{% endif %}

# Required package posture for future container/ZeroTier work.
{% for routeros_required_package in routeros_pathb_supported_required_packages %}
:if ([:len [/system package find where name="{{ routeros_required_package }}"]] = 0) do={ :log warning "Required package missing: {{ routeros_required_package }}" }
{% endfor %}
{% for routeros_required_package in routeros_pathb_unsupported_required_packages %}
:log warning "Requested package {{ routeros_required_package }} is unsupported on RouterOS architecture {{ routeros_pathb_routeros_arch }}."
{% endfor %}
:log warning "{{ routeros_pathb_container_enablement_note }}"
{% if 'zerotier' in routeros_pathb_unsupported_required_packages %}
:log warning "{{ routeros_pathb_zerotier_arch_note }}"
{% endif %}

# Serial console posture.
:log info "Serial console mode expected by this role: {{ routeros_pathb_serial_console_mode }} at {{ routeros_pathb_serial_console_baud }} bps."

# Future HA note.
:log info "{{ routeros_pathb_future_ha_note }}"

# Inventory-backed Path B targets:
{% for routeros_target_host in routeros_pathb_target_hosts %}
:log info "Managed target {{ routeros_target_host.name }} mac={{ routeros_target_host.mac_address }} os={{ routeros_target_host.os_name }} {{ routeros_target_host.os_version }} machine={{ routeros_target_host.machine_type }} boot={{ routeros_target_host.boot_type }} flow={{ routeros_target_host.protocol_flow }}"
{% endfor %}
