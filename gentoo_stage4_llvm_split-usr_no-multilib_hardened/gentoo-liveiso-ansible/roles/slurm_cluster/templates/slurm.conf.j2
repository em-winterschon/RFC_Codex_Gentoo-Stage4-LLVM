# Managed by Ansible. Do not edit by hand.
ClusterName={{ resolved_slurm_cluster.cluster_name }}
SlurmctldHost={{ resolved_slurm_cluster.control_machine }}({{ resolved_slurm_cluster.control_addr }})
SlurmUser={{ resolved_slurm_cluster.user }}
StateSaveLocation={{ resolved_slurm_cluster.state_save_location }}
SlurmdSpoolDir={{ resolved_slurm_cluster.slurmd_spool_dir }}
SlurmctldPort=6817
SlurmdPort=6818
AuthType=auth/munge
CryptoType=crypto/munge
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup
JobAcctGatherType=jobacct_gather/cgroup
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ resolved_slurm_cluster.control_machine }}
ReturnToService=2
SlurmctldLogFile={{ resolved_slurm_cluster.log_dir }}/slurmctld.log
SlurmdLogFile={{ resolved_slurm_cluster.log_dir }}/slurmd.log

{% for node in resolved_slurm_cluster.nodes %}
NodeName={{ node.name }} CPUs={{ node.cpus | default(1) }} RealMemory={{ node.real_memory | default(1024) }} State={{ node.state | default('UNKNOWN') }}{% if node.features | default([]) | length > 0 %} Feature={{ node.features | join(',') }}{% endif %}
{% endfor %}
{% if resolved_slurm_cluster.nodes | length == 0 %}
NodeName=DEFAULT CPUs=1 RealMemory=1024 State=UNKNOWN
{% endif %}

{% for partition in resolved_slurm_cluster.partitions %}
PartitionName={{ partition.name }} Nodes={{ partition.nodes | default('ALL') }} Default={{ 'YES' if partition.default | default(false) else 'NO' }} MaxTime={{ partition.max_time | default('12:00:00') }} State={{ partition.state | default('UP') }}
{% endfor %}
