# Generated by gentoo-liveiso-ansible
{% for radius_client in resolved_freeradius_bridge.clients %}
client {{ radius_client.shortname | default(radius_client.name) }} {
  ipaddr = {{ radius_client.ipaddr }}
  secret = {{ radius_client.secret }}
  shortname = {{ radius_client.shortname | default(radius_client.name) }}
  nastype = {{ radius_client.nastype | default('other') }}
{% if radius_client.virtual_server is defined %}
  virtual_server = {{ radius_client.virtual_server }}
{% endif %}
}

{% endfor %}
