# Generated by gentoo-liveiso-ansible
ldap stage5_freeipa {
  server = {{ resolved_freeradius_bridge.ldap_uri | quote }}
  identity = {{ resolved_freeradius_bridge.bind_dn | quote }}
  # FreeRADIUS parses ${...} as a configuration reference here. Render a
  # vault-backed secret directly into this root/radiusd-readable file.
  password = {{ resolved_freeradius_bridge.bind_password | default('CHANGE-ME-IN-VAULT') | quote }}
  base_dn = {{ resolved_freeradius_bridge.base_dn | quote }}
  tls {
    require_cert = {{ resolved_freeradius_bridge.tls_require_cert }}
  }
  user {
    base_dn = ${..base_dn}
    filter = "(uid=%{%{Stripped-User-Name}:-%{%{User-Name}:-none}})"
  }
  group {
    base_dn = ${..base_dn}
    filter = "(member=%{control:Ldap-UserDn})"
  }
}
