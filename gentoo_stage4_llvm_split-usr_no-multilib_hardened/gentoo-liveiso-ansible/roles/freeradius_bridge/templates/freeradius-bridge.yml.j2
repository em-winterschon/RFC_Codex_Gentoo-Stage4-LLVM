# Generated by gentoo-liveiso-ansible
enabled: {{ freeradius_bridge_enabled | bool | lower }}
backend: {{ resolved_freeradius_bridge.backend }}
ldap:
  uri: {{ resolved_freeradius_bridge.ldap_uri }}
  base_dn: {{ resolved_freeradius_bridge.base_dn }}
  bind_dn: {{ resolved_freeradius_bridge.bind_dn }}
  bind_password_file: {{ resolved_freeradius_bridge.bind_password_file }}
listeners:
  auth_port: {{ resolved_freeradius_bridge.auth_port }}
  acct_port: {{ resolved_freeradius_bridge.acct_port }}
  addresses:
{% for address in resolved_freeradius_bridge.listen_addresses %}
    - {{ address }}
{% endfor %}
tls_require_cert: {{ resolved_freeradius_bridge.tls_require_cert }}
clients:
{{ resolved_freeradius_bridge.clients | to_nice_yaml(indent=2) | indent(2, true) }}
group_mappings:
{{ resolved_freeradius_bridge.group_mappings | to_nice_yaml(indent=2) | indent(2, true) }}
