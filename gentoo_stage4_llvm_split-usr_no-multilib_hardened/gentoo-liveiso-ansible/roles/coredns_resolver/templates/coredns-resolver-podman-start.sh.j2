#!/usr/bin/env bash
set -euo pipefail

container_name={{ coredns_resolver_container_name | quote }}
image={{ coredns_resolver_image | quote }}
config_dir={{ coredns_resolver_config_dir | quote }}
log_dir={{ coredns_resolver_log_dir | quote }}

mkdir -p "${config_dir}" "${log_dir}"

exec /usr/bin/podman run \
  --replace \
  --name "${container_name}" \
  --network {{ coredns_resolver_network_mode | quote }} \
  --pull {{ coredns_resolver_pull_policy | quote }} \
  --volume "${config_dir}:/etc/coredns:ro" \
  --volume "${log_dir}:/var/log/coredns:rw" \
{% for arg in coredns_resolver_extra_podman_args %}
  {{ arg | quote }} \
{% endfor %}
  "${image}" \
  -conf /etc/coredns/Corefile
