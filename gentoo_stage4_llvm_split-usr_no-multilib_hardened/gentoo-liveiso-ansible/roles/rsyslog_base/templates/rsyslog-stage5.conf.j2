# Generated by gentoo-liveiso-ansible
global(
  workDirectory="{{ resolved_rsyslog.queue_spool_directory }}"
)

module(load="imuxsock")
module(load="imklog")
{% if resolved_rsyslog.listen_udp | bool %}
module(load="imudp")
input(type="imudp" port="{{ resolved_rsyslog.udp_port }}")
{% endif %}
{% if resolved_rsyslog.listen_tcp | bool %}
module(load="imtcp")
input(type="imtcp" port="{{ resolved_rsyslog.tcp_port }}")
{% endif %}

template(name="{{ resolved_rsyslog.template_name }}" type="string" string="{{ resolved_rsyslog.template_string }}")

{% if resolved_rsyslog.forward_enabled | bool and resolved_rsyslog.forward_hostname | length > 0 %}
action(
  type="omfwd"
  target="{{ resolved_rsyslog.forward_hostname }}"
  port="{{ resolved_rsyslog.forward_port }}"
  protocol="{{ resolved_rsyslog.forward_protocol }}"
  template="{{ resolved_rsyslog.template_name }}"
  queue.type="LinkedList"
  queue.filename="stage5-forward"
  action.resumeRetryCount="-1"
{% if resolved_rsyslog.tls_enabled | bool %}
  StreamDriver="gtls"
  StreamDriverMode="1"
  StreamDriverAuthMode="x509/name"
  tls.cacert="{{ resolved_rsyslog.tls_ca_file }}"
{% endif %}
)
{% endif %}
