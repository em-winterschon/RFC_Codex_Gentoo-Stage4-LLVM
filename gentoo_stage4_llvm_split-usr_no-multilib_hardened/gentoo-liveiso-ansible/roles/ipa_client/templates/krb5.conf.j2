[libdefaults]
  default_realm = {{ resolved_ipa_client.realm }}
  dns_lookup_realm = true
  dns_lookup_kdc = true
  rdns = false
  ticket_lifetime = 24h
  forwardable = true

[realms]
  {{ resolved_ipa_client.realm }} = {
{% if resolved_ipa_client.servers | length > 0 %}
    kdc = {{ resolved_ipa_client.servers[0] }}
    admin_server = {{ resolved_ipa_client.servers[0] }}
{% else %}
    kdc = _srv_
    admin_server = _srv_
{% endif %}
  }

[domain_realm]
  .{{ resolved_ipa_client.domain }} = {{ resolved_ipa_client.realm }}
  {{ resolved_ipa_client.domain }} = {{ resolved_ipa_client.realm }}
