[sssd]
services = nss, pam, sudo, ssh
config_file_version = 2
domains = {{ resolved_ipa_client.domain }}

[nss]
homedir_substring = /home

[pam]
{% if resolved_ipa_client.mkhomedir | bool %}
pam_verbosity = 1
{% endif %}

[domain/{{ resolved_ipa_client.domain }}]
id_provider = ipa
auth_provider = ipa
chpass_provider = ipa
access_provider = {{ resolved_ipa_client.access_provider }}
sudo_provider = {{ resolved_ipa_client.sudo_provider }}
subdomains_provider = ipa
cache_credentials = {{ resolved_ipa_client.cache_credentials | bool | lower }}
enumerate = {{ resolved_ipa_client.enumerate | bool | lower }}
ipa_domain = {{ resolved_ipa_client.domain }}
krb5_realm = {{ resolved_ipa_client.realm }}
{% if resolved_ipa_client.servers | length > 0 %}
ipa_server = {{ resolved_ipa_client.servers | join(', ') }}
{% else %}
ipa_server = _srv_
{% endif %}
dyndns_update = false
fallback_homedir = {{ resolved_ipa_client.home_dir_template }}
default_shell = {{ resolved_ipa_client.default_shell }}
ldap_tls_cacert = {{ resolved_ipa_client.ca_cert_path }}
