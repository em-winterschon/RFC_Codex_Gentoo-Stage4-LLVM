# Generated by gentoo-liveiso-ansible
enabled: {{ ipa_client_enabled | bool | lower }}
domain: {{ resolved_ipa_client.domain }}
realm: {{ resolved_ipa_client.realm }}
servers:
{% for server in resolved_ipa_client.servers %}
  - {{ server }}
{% endfor %}
domain_join_mode: {{ resolved_ipa_client.domain_join_mode }}
configure_krb5: {{ resolved_ipa_client.configure_krb5 | bool | lower }}
configure_sssd: {{ resolved_ipa_client.configure_sssd | bool | lower }}
mkhomedir: {{ resolved_ipa_client.mkhomedir | bool | lower }}
ssh_trust_ipa_keys: {{ resolved_ipa_client.ssh_trust_ipa_keys | bool | lower }}
providers:
  access: {{ resolved_ipa_client.access_provider }}
  hbac: {{ resolved_ipa_client.hbac_provider }}
  sudo: {{ resolved_ipa_client.sudo_provider }}
aaa_policy:
{{ resolved_profile_aaa_policy | to_nice_yaml(indent=2) | indent(2, true) }}
