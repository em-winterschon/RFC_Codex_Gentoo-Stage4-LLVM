#!/usr/bin/env bash
set -euo pipefail

UPS_NAME="${1:-{{ resolved_nut_monitoring.device_name }}@localhost}"
TEXTFILE="${2:-{{ resolved_nut_monitoring.textfile_output }}}"
TEXTFILE_DIR="$(dirname "${TEXTFILE}")"
tmpfile="$(mktemp "${TEXTFILE_DIR}/.nut_ups.prom.XXXXXX")"
datafile="$(mktemp)"

cleanup() {
  rm -f "${tmpfile}" "${datafile}"
}
trap cleanup EXIT

mkdir -p "${TEXTFILE_DIR}"

nut_emit_metric() {
  local metric_name="$1"
  local help_text="$2"
  local value="$3"

  printf '# HELP %s %s\n' "${metric_name}" "${help_text}" >> "${tmpfile}"
  printf '# TYPE %s gauge\n' "${metric_name}" >> "${tmpfile}"
  printf '%s{ups="%s"} %s\n' "${metric_name}" "${UPS_NAME}" "${value}" >> "${tmpfile}"
}

nut_value() {
  local key="$1"
  awk -v key="${key}" '$1 == key ":" { sub("^" key ": ", ""); print; exit }' "${datafile}"
}

if upsc "${UPS_NAME}" > "${datafile}" 2>/dev/null; then
  nut_emit_metric rfc1918_nut_ups_up "NUT UPS scrape status." 1
else
  : > "${tmpfile}"
  nut_emit_metric rfc1918_nut_ups_up "NUT UPS scrape status." 0
  chmod 0644 "${tmpfile}"
  mv "${tmpfile}" "${TEXTFILE}"
  exit 0
fi

declare -A nut_numeric_metrics=(
  ["battery.charge"]="rfc1918_nut_ups_battery_charge_percent|UPS battery charge percent."
  ["battery.runtime"]="rfc1918_nut_ups_battery_runtime_seconds|UPS estimated battery runtime seconds."
  ["input.voltage"]="rfc1918_nut_ups_input_voltage_volts|UPS input voltage."
  ["output.voltage"]="rfc1918_nut_ups_output_voltage_volts|UPS output voltage."
  ["ups.load"]="rfc1918_nut_ups_load_percent|UPS load percent."
  ["ups.realpower.nominal"]="rfc1918_nut_ups_realpower_nominal_watts|UPS nominal real power watts."
)

for key in "${!nut_numeric_metrics[@]}"; do
  value="$(nut_value "${key}")"
  if [[ "${value}" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    metric="${nut_numeric_metrics[${key}]%%|*}"
    help="${nut_numeric_metrics[${key}]#*|}"
    nut_emit_metric "${metric}" "${help}" "${value}"
  fi
done

status="$(nut_value ups.status)"
on_battery=0
online=0
low_battery=0
if [[ " ${status} " == *" OB "* ]]; then
  on_battery=1
fi
if [[ " ${status} " == *" OL "* ]]; then
  online=1
fi
if [[ " ${status} " == *" LB "* ]]; then
  low_battery=1
fi

nut_emit_metric rfc1918_nut_ups_status_on_battery "UPS status includes OB." "${on_battery}"
nut_emit_metric rfc1918_nut_ups_status_online "UPS status includes OL." "${online}"
nut_emit_metric rfc1918_nut_ups_status_low_battery "UPS status includes LB." "${low_battery}"
nut_emit_metric rfc1918_nut_ups_last_scrape_unixtime "UPS textfile collector last successful scrape time." "$(date +%s)"

chmod 0644 "${tmpfile}"
mv "${tmpfile}" "${TEXTFILE}"
