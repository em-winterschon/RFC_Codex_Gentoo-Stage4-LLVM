# Forge memory object-store runtime environment.
# This file intentionally contains endpoints and object-layout settings only.
# S3 access keys and secret keys must be supplied by vault/runtime injection.

AWS_ENDPOINT_URL={{ resolved_forge_memory_object_store.endpoint_url }}
AWS_DEFAULT_REGION={{ resolved_forge_memory_object_store.region }}
FORGE_MEMORY_S3_BUCKET={{ resolved_forge_memory_object_store.bucket }}
FORGE_MEMORY_S3_PREFIX={{ resolved_forge_memory_object_store.prefix }}
FORGE_MEMORY_SPOOL_ROOT={{ resolved_forge_memory_object_store.spool_root }}
FORGE_MEMORY_AUDIT_PREFIX={{ resolved_forge_memory_object_store.audit_log_prefix }}
FORGE_MEMORY_OBJECT_STORE_POLICY={{ resolved_forge_memory_object_store.config_dir }}/object-store-policy.yml
