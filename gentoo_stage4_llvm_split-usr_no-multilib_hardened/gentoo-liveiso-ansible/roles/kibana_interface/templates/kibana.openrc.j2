#!/sbin/openrc-run

name="Kibana"
description="Elastic Kibana web interface"
command="{{ resolved_kibana.install_root }}/current/bin/kibana"
command_user="{{ resolved_kibana.service_user }}:{{ resolved_kibana.service_user }}"
directory="{{ resolved_kibana.install_root }}/current"
supervisor="supervise-daemon"
pidfile="/run/kibana/kibana.pid"
output_log="/var/log/kibana/kibana-openrc.log"
error_log="/var/log/kibana/kibana-openrc.err"
respawn_delay=10
respawn_period=60
respawn_max=3

export TZ="{{ resolved_kibana.timezone }}"
export KBN_PATH_CONF="/etc/kibana"
export NODE_OPTIONS="{{ resolved_kibana.node_options }}"

depend() {
  need net
  after firewall
}

start_pre() {
  checkpath -d -m 0755 -o {{ resolved_kibana.service_user }}:{{ resolved_kibana.service_user }} /run/kibana /var/lib/kibana /var/log/kibana {{ resolved_kibana.install_root }}/current/data
}
