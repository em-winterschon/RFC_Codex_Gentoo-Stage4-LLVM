global
  log stdout format raw local0
  user haproxy
  group haproxy
  daemon
  maxconn 2048

defaults
  log global
  option dontlognull
  timeout connect 5s
  timeout client 30s
  timeout server 30s

{% set configured_haproxy_service_types = resolved_haproxy_service_types_local | default([]) %}

{% if configured_haproxy_service_types | length > 0 %}
{% for service_type in configured_haproxy_service_types %}
frontend fe_{{ service_type.name | replace('-', '_') }}
  mode {{ service_type.mode | default('http') }}
{% if service_type.mode | default('http') == 'http' %}
  option httplog
{% else %}
  option tcplog
{% endif %}
{% if service_type.log_requests is defined and not (service_type.log_requests | bool) %}
  option dontlog-normal
{% endif %}
{% if service_type.tls is defined and service_type.tls.enabled | default(false) | bool %}
  bind {{ service_type.bind }} ssl crt {{ service_type.tls.cert_path }}
{% else %}
  bind {{ service_type.bind }}
{% endif %}
{% if service_type.mode | default('http') == 'http' and service_type.host_acl is defined and service_type.host_acl | length > 0 %}
  acl host_match hdr(host) -i {{ service_type.host_acl }}
  use_backend {{ service_type.backend_name }} if host_match
  default_backend be_fallback
{% else %}
  default_backend {{ service_type.backend_name }}
{% endif %}

backend {{ service_type.backend_name }}
  mode {{ service_type.mode | default('http') }}
{% for backend_server in service_type.servers | default([]) %}
  server {{ backend_server.name }} {{ backend_server.address }}:{{ backend_server.port }} check
{% endfor %}

{% endfor %}
{% endif %}

{% set ntfy_apps = container_runtime_applications | default([]) | selectattr('name', 'equalto', 'ntfy') | list %}
{% set nginx_apps = container_runtime_applications | default([]) | selectattr('name', 'equalto', 'nginx') | list %}
{% set nginx_ui_apps = container_runtime_applications | default([]) | selectattr('name', 'equalto', 'nginx-ui') | list %}
{% set mcp_generic_apps = container_runtime_applications | default([]) | selectattr('name', 'equalto', 'mcp-generic') | list %}
{% set haproxy_tls = container_haproxy_profile.tls | default({}) %}
{% set haproxy_tls_enabled = haproxy_tls.enabled | default(false) | bool %}
frontend fe_http
  mode http
  option httplog
  bind *:80
{% if nginx_ui_apps | length > 0 %}
{% set nginx_ui_app = nginx_ui_apps | first %}
  acl host_nginx_ui hdr(host) -i {{ nginx_ui_app.hostnames | default(['nginx-ui.local']) | join(' ') }}
  acl path_nginx_ui_mcp path_beg /mcp
  use_backend be_nginx_ui_mcp if host_nginx_ui path_nginx_ui_mcp
  use_backend be_nginx_ui if host_nginx_ui
{% endif %}
{% if mcp_generic_apps | length > 0 %}
{% set mcp_generic_app = mcp_generic_apps | first %}
  acl host_mcp_generic hdr(host) -i {{ mcp_generic_app.hostnames | default(['mcp-generic.local']) | join(' ') }}
  use_backend be_mcp_generic if host_mcp_generic
{% endif %}
{% if ntfy_apps | length > 0 %}
{% set ntfy_app = ntfy_apps | first %}
  acl host_ntfy hdr(host) -i {{ ntfy_app.hostnames | default(['ntfy.local']) | join(' ') }}
  use_backend be_ntfy if host_ntfy
{% endif %}
{% if nginx_apps | length > 0 %}
  default_backend be_nginx
{% else %}
  default_backend be_fallback
{% endif %}

{% if haproxy_tls_enabled %}
frontend fe_https
  mode http
  option httplog
{% if haproxy_tls.crt_list is defined and haproxy_tls.crt_list | length > 0 %}
  bind {{ haproxy_tls.bind | default('*:443') }} ssl crt-list {{ haproxy_tls.crt_list }}
{% else %}
  bind {{ haproxy_tls.bind | default('*:443') }} ssl crt {{ haproxy_tls.cert_path | default('/etc/haproxy/tls/haproxy.pem') }}
{% endif %}
{% if nginx_ui_apps | length > 0 %}
{% set nginx_ui_app = nginx_ui_apps | first %}
  acl host_nginx_ui hdr(host) -i {{ nginx_ui_app.hostnames | default(['nginx-ui.local']) | join(' ') }}
  acl path_nginx_ui_mcp path_beg /mcp
  use_backend be_nginx_ui_mcp if host_nginx_ui path_nginx_ui_mcp
  use_backend be_nginx_ui if host_nginx_ui
{% endif %}
{% if mcp_generic_apps | length > 0 %}
{% set mcp_generic_app = mcp_generic_apps | first %}
  acl host_mcp_generic hdr(host) -i {{ mcp_generic_app.hostnames | default(['mcp-generic.local']) | join(' ') }}
  use_backend be_mcp_generic if host_mcp_generic
{% endif %}
{% if ntfy_apps | length > 0 %}
{% set ntfy_app = ntfy_apps | first %}
  acl host_ntfy hdr(host) -i {{ ntfy_app.hostnames | default(['ntfy.local']) | join(' ') }}
  use_backend be_ntfy if host_ntfy
{% endif %}
{% for service_type in configured_haproxy_service_types %}
{% if service_type.mode | default('http') == 'http' and service_type.tls_https_route | default(false) | bool and service_type.host_acl is defined and service_type.host_acl | length > 0 %}
  acl host_{{ service_type.name | replace('-', '_') }} hdr(host) -i {{ service_type.host_acl }}
  use_backend {{ service_type.backend_name }} if host_{{ service_type.name | replace('-', '_') }}
{% endif %}
{% endfor %}
{% if nginx_apps | length > 0 %}
  default_backend be_nginx
{% else %}
  default_backend be_fallback
{% endif %}

{% endif %}

{% if nginx_ui_apps | length > 0 %}
{% set nginx_ui_app = nginx_ui_apps | first %}
backend be_nginx_ui_mcp
  mode http
  option dontlog-normal
  server nginx-ui {{ nginx_ui_app.ip_address | default('10.77.1.60') }}:{{ nginx_ui_app.backend_port | default(80) }} check

backend be_nginx_ui
  mode http
  server nginx-ui {{ nginx_ui_app.ip_address | default('10.77.1.60') }}:{{ nginx_ui_app.backend_port | default(80) }} check
{% endif %}

{% if mcp_generic_apps | length > 0 %}
{% set mcp_generic_app = mcp_generic_apps | first %}
backend be_mcp_generic
  mode http
  option dontlog-normal
  server mcp-generic {{ mcp_generic_app.ip_address | default('10.77.1.61') }}:{{ mcp_generic_app.backend_port | default(3000) }} check
{% endif %}

{% if nginx_apps | length > 0 %}
{% set nginx_app = nginx_apps | first %}
backend be_nginx
  mode http
  server nginx {{ nginx_app.ip_address | default('10.77.1.30') }}:80 check
{% endif %}

{% if ntfy_apps | length > 0 %}
{% set ntfy_app = ntfy_apps | first %}
backend be_ntfy
  mode http
  server ntfy {{ ntfy_app.ip_address | default('10.77.1.20') }}:{{ ntfy_app.backend_port | default(8080) }} check
{% endif %}

backend be_fallback
  mode http
  http-request return status 503 content-type text/plain string "no backend configured\n"
