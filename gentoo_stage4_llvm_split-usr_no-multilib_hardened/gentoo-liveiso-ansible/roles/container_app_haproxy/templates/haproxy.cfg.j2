global
  log stdout format raw local0
  user haproxy
  group haproxy
  daemon
  maxconn 2048

defaults
  log global
  option dontlognull
  timeout connect 5s
  timeout client 30s
  timeout server 30s

{% set configured_haproxy_service_types = resolved_haproxy_service_types_local | default([]) %}

{% if configured_haproxy_service_types | length > 0 %}
{% for service_type in configured_haproxy_service_types %}
frontend fe_{{ service_type.name | replace('-', '_') }}
  mode {{ service_type.mode | default('http') }}
{% if service_type.mode | default('http') == 'http' %}
  option httplog
{% else %}
  option tcplog
{% endif %}
  bind {{ service_type.bind }}
{% if service_type.mode | default('http') == 'http' and service_type.host_acl is defined and service_type.host_acl | length > 0 %}
  acl host_match hdr(host) -i {{ service_type.host_acl }}
  use_backend {{ service_type.backend_name }} if host_match
  default_backend be_fallback
{% else %}
  default_backend {{ service_type.backend_name }}
{% endif %}

backend {{ service_type.backend_name }}
  mode {{ service_type.mode | default('http') }}
{% for backend_server in service_type.servers | default([]) %}
  server {{ backend_server.name }} {{ backend_server.address }}:{{ backend_server.port }} check
{% endfor %}

{% endfor %}
{% endif %}

{% set ntfy_apps = container_runtime_applications | default([]) | selectattr('name', 'equalto', 'ntfy') | list %}
{% set nginx_apps = container_runtime_applications | default([]) | selectattr('name', 'equalto', 'nginx') | list %}
frontend fe_http
  mode http
  option httplog
  bind *:80
{% if ntfy_apps | length > 0 %}
{% set ntfy_app = ntfy_apps | first %}
  acl host_ntfy hdr(host) -i {{ ntfy_app.hostnames | default(['ntfy.local']) | join(' ') }}
  use_backend be_ntfy if host_ntfy
{% endif %}
{% if nginx_apps | length > 0 %}
  default_backend be_nginx
{% else %}
  default_backend be_fallback
{% endif %}

{% if nginx_apps | length > 0 %}
{% set nginx_app = nginx_apps | first %}
backend be_nginx
  mode http
  server nginx {{ nginx_app.ip_address | default('10.77.1.30') }}:80 check
{% endif %}

{% if ntfy_apps | length > 0 %}
{% set ntfy_app = ntfy_apps | first %}
backend be_ntfy
  mode http
  server ntfy {{ ntfy_app.ip_address | default('10.77.1.20') }}:{{ ntfy_app.backend_port | default(8080) }} check
{% endif %}

backend be_fallback
  mode http
  http-request return status 503 content-type text/plain string "no backend configured\n"
