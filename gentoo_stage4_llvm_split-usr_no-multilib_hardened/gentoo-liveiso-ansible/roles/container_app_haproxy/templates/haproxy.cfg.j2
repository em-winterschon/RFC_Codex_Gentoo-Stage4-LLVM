global
  log stdout format raw local0
  daemon
  maxconn 2048

defaults
  log global
  option httplog
  option dontlognull
  timeout connect 5s
  timeout client 30s
  timeout server 30s

{% set configured_haproxy_service_types = resolved_haproxy_service_types_local | default([]) %}

{% if configured_haproxy_service_types | length > 0 %}
{% for service_type in configured_haproxy_service_types %}
frontend fe_{{ service_type.name | replace('-', '_') }}
  mode {{ service_type.mode | default('http') }}
  bind {{ service_type.bind }}
{% if service_type.mode | default('http') == 'http' and service_type.host_acl is defined and service_type.host_acl | length > 0 %}
  acl host_match hdr(host) -i {{ service_type.host_acl }}
  use_backend {{ service_type.backend_name }} if host_match
  default_backend be_fallback
{% else %}
  default_backend {{ service_type.backend_name }}
{% endif %}

backend {{ service_type.backend_name }}
  mode {{ service_type.mode | default('http') }}
{% for backend_server in service_type.servers | default([]) %}
  server {{ backend_server.name }} {{ backend_server.address }}:{{ backend_server.port }} check
{% endfor %}

{% endfor %}
{% else %}
frontend fe_http
  bind *:80
{% if (container_runtime_applications | default([]) | selectattr('name', 'equalto', 'ntfy') | list | length) > 0 %}
  acl host_ntfy hdr(host) -i ntfy.local
  use_backend be_ntfy if host_ntfy
{% endif %}
{% if (container_runtime_applications | default([]) | selectattr('name', 'equalto', 'nginx') | list | length) > 0 %}
  default_backend be_nginx
{% else %}
  default_backend be_fallback
{% endif %}

{% if (container_runtime_applications | default([]) | selectattr('name', 'equalto', 'nginx') | list | length) > 0 %}
backend be_nginx
  server nginx {{ (container_runtime_applications | selectattr('name', 'equalto', 'nginx') | first).ip_address | default('10.77.1.30') }}:80 check
{% endif %}

{% if (container_runtime_applications | default([]) | selectattr('name', 'equalto', 'ntfy') | list | length) > 0 %}
backend be_ntfy
  server ntfy {{ (container_runtime_applications | selectattr('name', 'equalto', 'ntfy') | first).ip_address | default('10.77.1.20') }}:80 check
{% endif %}
{% endif %}

backend be_fallback
  mode http
  http-request return status 503 content-type text/plain string "no backend configured\n"
