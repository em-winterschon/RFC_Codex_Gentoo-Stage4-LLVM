### Managed by gentoo-liveiso-ansible devuan_netboot_assets

d-i debian-installer/locale string {{ resolved_devuan_netboot.locale }}
d-i keyboard-configuration/xkb-keymap select {{ resolved_devuan_netboot.keymap }}
d-i time/zone string {{ resolved_devuan_netboot.timezone }}
d-i clock-setup/utc boolean true

d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string {{ resolved_devuan_netboot.hostname }}
d-i netcfg/get_domain string {{ resolved_devuan_netboot.domain }}

d-i mirror/country string manual
d-i mirror/http/hostname string {{ resolved_devuan_netboot.mirror_host }}
d-i mirror/http/directory string {{ resolved_devuan_netboot.mirror_directory }}
d-i mirror/http/proxy string

d-i passwd/root-login boolean true
d-i passwd/root-password-crypted password {{ resolved_devuan_netboot.root_password_hash }}
d-i passwd/user-fullname string Codex Automation
d-i passwd/username string {{ resolved_devuan_netboot.codex_user }}
d-i passwd/user-password-crypted password {{ resolved_devuan_netboot.codex_password_hash }}
d-i user-setup/allow-password-weak boolean true

d-i apt-setup/non-free boolean false
d-i apt-setup/contrib boolean false
tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string {{ resolved_devuan_netboot.extra_packages | join(' ') }}
d-i pkgsel/upgrade select none
popularity-contest popularity-contest/participate boolean false

{% if resolved_devuan_netboot.autoinstall_enabled | bool %}
d-i partman-auto/disk string {{ resolved_devuan_netboot.disk }}
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
{% else %}
### Disk partitioning is intentionally interactive unless
### devuan_netboot_autoinstall_enabled=true is set for a disposable VM.
{% endif %}

d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string {{ resolved_devuan_netboot.disk }}

d-i preseed/late_command string \
  in-target /bin/sh -c 'echo "{{ resolved_devuan_netboot.codex_user }} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-codex'; \
  in-target chmod 0440 /etc/sudoers.d/90-codex; \
{% if resolved_devuan_netboot.codex_ssh_authorized_key | length > 0 %}
  in-target mkdir -p /home/{{ resolved_devuan_netboot.codex_user }}/.ssh; \
  in-target /bin/sh -c 'printf "%s\n" "{{ resolved_devuan_netboot.codex_ssh_authorized_key }}" > /home/{{ resolved_devuan_netboot.codex_user }}/.ssh/authorized_keys'; \
  in-target chown -R {{ resolved_devuan_netboot.codex_user }}:{{ resolved_devuan_netboot.codex_user }} /home/{{ resolved_devuan_netboot.codex_user }}/.ssh; \
  in-target chmod 0700 /home/{{ resolved_devuan_netboot.codex_user }}/.ssh; \
  in-target chmod 0600 /home/{{ resolved_devuan_netboot.codex_user }}/.ssh/authorized_keys; \
{% endif %}
  true

d-i finish-install/reboot_in_progress note
