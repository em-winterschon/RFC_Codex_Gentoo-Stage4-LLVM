# RouterOS CRS309 spine/distribution intent
# Generated by Ansible role: routeros_spine_distribution
# Render-only until live import is explicitly gated.

:local cfgTag "RFC99-CRS309-SPINE.001"
:log info ("[" . $cfgTag . "] starting CRS309 spine normalization")

/system backup save name=pre-crs309-spine-distribution
/export file=pre-crs309-spine-distribution hide-sensitive

/system identity set name="{{ routeros_spine_distribution_spine.identity }}"
/system clock set time-zone-name="{{ routeros_spine_distribution_timezone }}"

:if ([/system resource get version] != "{{ routeros_spine_distribution_target_version }} (stable)") do={
    :log warning ("[" . $cfgTag . "] expected RouterOS {{ routeros_spine_distribution_target_version }}; observed " . [/system resource get version])
}
:if ([/system routerboard get current-firmware] != "{{ routeros_spine_distribution_target_version }}") do={
    :log warning ("[" . $cfgTag . "] expected RouterBOARD firmware {{ routeros_spine_distribution_target_version }}; observed " . [/system routerboard get current-firmware])
}

{% for item in routeros_spine_distribution_spine.uplinks %}
:if ([:len [/interface ethernet find where name="{{ item.interface }}"]] > 0) do={
    /interface ethernet set [find where name="{{ item.interface }}"] comment="{{ item.comment }}"
}
{% endfor %}

:if ([:len [/interface bridge find where name="{{ routeros_spine_distribution_spine.bridge }}"]] = 0) do={
    /interface bridge add name="{{ routeros_spine_distribution_spine.bridge }}" protocol-mode=rstp vlan-filtering=no comment="RFC99 CRS309 spine bridge"
} else={
    /interface bridge set [find where name="{{ routeros_spine_distribution_spine.bridge }}"] protocol-mode=rstp vlan-filtering=no comment="RFC99 CRS309 spine bridge"
}

:if ([:len [/interface bonding find where name="{{ routeros_spine_distribution_spine.crs354_bond.name }}"]] = 0) do={
    /interface bonding add name="{{ routeros_spine_distribution_spine.crs354_bond.name }}" mode=802.3ad slaves={{ routeros_spine_distribution_spine.crs354_bond.slaves | join(',') }} lacp-rate=1sec lacp-mode=active transmit-hash-policy=layer-2 comment="CRS354 distribution LACP"
} else={
    /interface bonding set [find where name="{{ routeros_spine_distribution_spine.crs354_bond.name }}"] mode=802.3ad slaves={{ routeros_spine_distribution_spine.crs354_bond.slaves | join(',') }} lacp-rate=1sec lacp-mode=active transmit-hash-policy=layer-2 comment="CRS354 distribution LACP"
}

{% for slave in routeros_spine_distribution_spine.crs354_bond.slaves %}
/interface bridge port remove [find where interface="{{ slave }}"]
{% endfor %}
:if ([:len [/interface bridge port find where interface="{{ routeros_spine_distribution_spine.crs354_bond.name }}"]] = 0) do={
    /interface bridge port add bridge="{{ routeros_spine_distribution_spine.bridge }}" interface="{{ routeros_spine_distribution_spine.crs354_bond.name }}" comment="CRS354 distribution LACP"
} else={
    /interface bridge port set [find where interface="{{ routeros_spine_distribution_spine.crs354_bond.name }}"] bridge="{{ routeros_spine_distribution_spine.bridge }}" comment="CRS354 distribution LACP"
}

/tool bandwidth-server set enabled=no
:if ([:len [/ip service find where name="reverse-proxy"]] > 0) do={ /ip service set reverse-proxy disabled=yes }

:put "### validate-crs309-version"
/system resource print
/system routerboard print
:put "### validate-crs309-bond"
/interface bonding monitor "{{ routeros_spine_distribution_spine.crs354_bond.name }}" once
/interface ethernet monitor {{ routeros_spine_distribution_spine.crs354_bond.slaves | join(',') }} once
/interface bridge port print terse where interface="{{ routeros_spine_distribution_spine.crs354_bond.name }}"
:put "### validate-crs309-reachability"
/ping {{ routeros_spine_distribution_distribution.management_ip }} count=5
/ping {{ routeros_spine_distribution_spine.gateway }} count=5

:log info ("[" . $cfgTag . "] CRS309 spine normalization complete")
