# RouterOS CRS354 distribution intent
# Generated by Ansible role: routeros_spine_distribution
# Render-only until live import is explicitly gated.

:local cfgTag "RFC99-CRS354-DIST.001"
:log info ("[" . $cfgTag . "] starting CRS354 distribution normalization")

/system backup save name=pre-crs354-distribution
/export file=pre-crs354-distribution hide-sensitive

/system identity set name="{{ routeros_spine_distribution_distribution.identity }}"
/system clock set time-zone-name="{{ routeros_spine_distribution_timezone }}"

:if ([/system resource get version] != "{{ routeros_spine_distribution_target_version }} (stable)") do={
    :log warning ("[" . $cfgTag . "] expected RouterOS {{ routeros_spine_distribution_target_version }}; observed " . [/system resource get version])
}
:if ([/system routerboard get current-firmware] != "{{ routeros_spine_distribution_target_version }}") do={
    :log warning ("[" . $cfgTag . "] expected RouterBOARD firmware {{ routeros_spine_distribution_target_version }}; observed " . [/system routerboard get current-firmware])
}

/ip address disable [find where interface="{{ routeros_spine_distribution_distribution.stale_opnsense.interface }}" and address="{{ routeros_spine_distribution_distribution.stale_opnsense.address }}"]
/ip route disable [find where gateway="{{ routeros_spine_distribution_distribution.stale_opnsense.gateway }}"]

{% for item in routeros_spine_distribution_distribution.uplinks %}
:if ([:len [/interface ethernet find where name="{{ item.interface }}"]] > 0) do={
    /interface ethernet set [find where name="{{ item.interface }}"] comment="{{ item.comment }}"
}
{% endfor %}

:if ([:len [/interface bonding find where name="{{ routeros_spine_distribution_distribution.crs309_bond.name }}"]] = 0) do={
    /interface bonding add name="{{ routeros_spine_distribution_distribution.crs309_bond.name }}" mode=802.3ad slaves={{ routeros_spine_distribution_distribution.crs309_bond.slaves | join(',') }} lacp-rate=1sec lacp-mode=active transmit-hash-policy=layer-2 comment="CRS309 spine LACP"
} else={
    /interface bonding set [find where name="{{ routeros_spine_distribution_distribution.crs309_bond.name }}"] mode=802.3ad slaves={{ routeros_spine_distribution_distribution.crs309_bond.slaves | join(',') }} lacp-rate=1sec lacp-mode=active transmit-hash-policy=layer-2 comment="CRS309 spine LACP"
}

{% for slave in routeros_spine_distribution_distribution.crs309_bond.slaves %}
/interface bridge port remove [find where interface="{{ slave }}"]
{% endfor %}
:if ([:len [/interface bridge port find where interface="{{ routeros_spine_distribution_distribution.crs309_bond.name }}"]] = 0) do={
    /interface bridge port add bridge="{{ routeros_spine_distribution_distribution.bridge }}" interface="{{ routeros_spine_distribution_distribution.crs309_bond.name }}" comment="CRS309 spine LACP"
} else={
    /interface bridge port set [find where interface="{{ routeros_spine_distribution_distribution.crs309_bond.name }}"] bridge="{{ routeros_spine_distribution_distribution.bridge }}" comment="CRS309 spine LACP"
}

/tool bandwidth-server set enabled=no
:if ([:len [/ip service find where name="reverse-proxy"]] > 0) do={ /ip service set reverse-proxy disabled=yes }

:put "### validate-crs354-stale-state"
/ip address print detail where interface="{{ routeros_spine_distribution_distribution.stale_opnsense.interface }}"
/ip route print detail where gateway="{{ routeros_spine_distribution_distribution.stale_opnsense.gateway }}"
:put "### validate-crs354-bond"
/interface bonding monitor "{{ routeros_spine_distribution_distribution.crs309_bond.name }}" once
/interface ethernet monitor {{ routeros_spine_distribution_distribution.crs309_bond.slaves | join(',') }} once
/interface bridge port print terse where interface="{{ routeros_spine_distribution_distribution.crs309_bond.name }}"
:put "### validate-crs354-reachability"
/ping {{ routeros_spine_distribution_spine.management_ip }} count=5

:log info ("[" . $cfgTag . "] CRS354 distribution normalization complete")
