# RouterOS RFC99 physical gateway configuration
# Generated by Ansible role: routeros_rfc99_gateway
# Target model: {{ routeros_rfc99_gateway_expected_model }}
# Target board-name observed: {{ routeros_rfc99_gateway_expected_board_name }}
# Source lineage: CRS309 RouterOS replacement script translated for CCR2004-16G-2S+PC.

:local cfgTag "{{ routeros_rfc99_gateway_cfg_tag }}"
:log info ("[" . $cfgTag . "] starting RFC99 CCR2004 gateway import")

/system backup save name=pre-rfc99-ccr2004
/export file=pre-rfc99-ccr2004 hide-sensitive

:if ([:len [/interface ethernet find where default-name="{{ routeros_rfc99_gateway_wan_interface }}"]] = 0) do={
    :error ("[" . $cfgTag . "] missing required WAN interface {{ routeros_rfc99_gateway_wan_interface }}")
}
:if ([:len [/interface ethernet find where default-name="{{ routeros_rfc99_gateway_lan_uplink_interface }}"]] = 0) do={
    :error ("[" . $cfgTag . "] missing required LAN uplink interface {{ routeros_rfc99_gateway_lan_uplink_interface }}")
}
:if ([:len [/interface ethernet find where default-name="ether16"]] = 0) do={
    :error ("[" . $cfgTag . "] missing ether16; this render target expects CCR2004-16G class hardware")
}

/system identity set name="{{ routeros_rfc99_gateway_identity }}"
/system note set show-at-login=yes note="{{ routeros_rfc99_gateway_note }}"
/system clock set time-zone-name="{{ routeros_rfc99_gateway_timezone }}"

# Normalize copper interface names to the repository geN convention.
{% for routeros_if_rename in routeros_rfc99_gateway_interface_renames %}
:if ([:len [/interface ethernet find where default-name="{{ routeros_if_rename.default_name }}"]] > 0) do={ /interface ethernet set [find default-name="{{ routeros_if_rename.default_name }}"] name="{{ routeros_if_rename.name }}" }
{% endfor %}

/interface ethernet set [find default-name="{{ routeros_rfc99_gateway_wan_interface }}"] comment="WAN uplink"
/interface ethernet set [find default-name="{{ routeros_rfc99_gateway_lan_uplink_interface }}"] comment="LAN switch uplink"
/interface ethernet set [find default-name="ether1"] comment="Dedicated management"

# Interface lists.
{% for routeros_list in routeros_rfc99_gateway_interface_lists %}
:if ([:len [/interface list find where name="{{ routeros_list }}"]] = 0) do={ /interface list add name="{{ routeros_list }}" comment="RFC99 gateway zone" }
/interface list member remove [find list="{{ routeros_list }}"]
{% endfor %}
/interface list member add list=WAN interface={{ routeros_rfc99_gateway_wan_interface }}
/interface list member add list=MGMT interface={{ routeros_rfc99_gateway_management_interface }}

# Routed LAN bridge and VLAN trunk on sfp-sfpplus2.
:if ([:len [/interface bridge find where name="{{ routeros_rfc99_gateway_lan_bridge }}"]] = 0) do={
    /interface bridge add name={{ routeros_rfc99_gateway_lan_bridge }} protocol-mode=rstp vlan-filtering=yes comment="RFC99 LAN bridge"
} else={
    /interface bridge set [find where name="{{ routeros_rfc99_gateway_lan_bridge }}"] protocol-mode=rstp vlan-filtering=yes comment="RFC99 LAN bridge"
}
/interface bridge port remove [find bridge="{{ routeros_rfc99_gateway_lan_bridge }}"]
/interface bridge port add bridge={{ routeros_rfc99_gateway_lan_bridge }} interface={{ routeros_rfc99_gateway_lan_uplink_interface }} frame-types=admit-all ingress-filtering=yes pvid={{ routeros_rfc99_gateway_native_vlan_id }}
/interface list member add list=LAN interface={{ routeros_rfc99_gateway_lan_bridge }}

/interface vlan remove [find comment~"RFC99 vlan"]
{% for routeros_vlan in routeros_rfc99_gateway_vlan_plan %}
{% if not (routeros_vlan.native | default(false) | bool) %}
/interface vlan add name=vlan{{ routeros_vlan.vlan_id }}-{{ routeros_vlan.name }} vlan-id={{ routeros_vlan.vlan_id }} interface={{ routeros_rfc99_gateway_lan_bridge }} comment="RFC99 vlan {{ routeros_vlan.name }}"
{% endif %}
{% endfor %}

/interface bridge vlan remove [find comment~"RFC99 vlan"]
{% for routeros_vlan in routeros_rfc99_gateway_vlan_plan %}
{% if routeros_vlan.native | default(false) | bool %}
/interface bridge vlan add bridge={{ routeros_rfc99_gateway_lan_bridge }} vlan-ids={{ routeros_vlan.vlan_id }} untagged={{ routeros_rfc99_gateway_lan_uplink_interface }},{{ routeros_rfc99_gateway_lan_bridge }} comment="RFC99 vlan {{ routeros_vlan.name }}"
{% else %}
/interface bridge vlan add bridge={{ routeros_rfc99_gateway_lan_bridge }} vlan-ids={{ routeros_vlan.vlan_id }} tagged={{ routeros_rfc99_gateway_lan_uplink_interface }},{{ routeros_rfc99_gateway_lan_bridge }} comment="RFC99 vlan {{ routeros_vlan.name }}"
{% endif %}
{% endfor %}

# L3 addresses. Remove the factory defconf address and RFC99-managed addresses only.
/ip address remove [find where address="192.168.88.1/24"]
/ip address remove [find comment~"RFC99"]
{% for routeros_vlan in routeros_rfc99_gateway_vlan_plan %}
{% if routeros_vlan.gateway_cidr is defined and routeros_vlan.gateway_cidr | length > 0 %}
{% if routeros_vlan.native | default(false) | bool %}
/ip address add address={{ routeros_vlan.gateway_cidr }} interface={{ routeros_rfc99_gateway_lan_bridge }} comment="RFC99 VLAN {{ routeros_vlan.name }}"
{% else %}
/ip address add address={{ routeros_vlan.gateway_cidr }} interface=vlan{{ routeros_vlan.vlan_id }}-{{ routeros_vlan.name }} comment="RFC99 VLAN {{ routeros_vlan.name }}"
{% endif %}
{% endif %}
{% endfor %}
{% for routeros_address in routeros_rfc99_gateway_legacy_bridge_addresses %}
/ip address add address={{ routeros_address.address }} interface={{ routeros_address.interface }} comment="RFC99 legacy {{ routeros_address.comment }}"
{% endfor %}

# WAN egress.
/ip dhcp-client remove [find interface="{{ routeros_rfc99_gateway_wan_interface }}"]
/ip route remove [find comment="RFC99 WAN default"]
{% if routeros_rfc99_gateway_wan_mode == 'dhcp' %}
/ip dhcp-client add interface={{ routeros_rfc99_gateway_wan_interface }} add-default-route=yes default-route-distance={{ routeros_rfc99_gateway_wan_route_distance }} use-peer-dns={{ routeros_rfc99_gateway_wan_use_peer_dns | ternary("yes", "no") }} use-peer-ntp=no comment="RFC99 WAN DHCP"
{% elif routeros_rfc99_gateway_wan_mode == 'static' %}
/ip address add address={{ routeros_rfc99_gateway_wan_cidr }} interface={{ routeros_rfc99_gateway_wan_interface }} comment="RFC99 WAN static"
/ip route add dst-address=0.0.0.0/0 gateway={{ routeros_rfc99_gateway_wan_gateway }} distance={{ routeros_rfc99_gateway_wan_route_distance }} comment="RFC99 WAN default"
{% else %}
:error ("[" . $cfgTag . "] invalid WAN mode {{ routeros_rfc99_gateway_wan_mode }}")
{% endif %}
/ip dns set servers={{ routeros_rfc99_gateway_dns_servers | join(',') }} allow-remote-requests={{ routeros_rfc99_gateway_dns_allow_remote_requests | ternary("yes", "no") }}

# Management services: SSH, HTTPS, and API-SSL only.
/ip service set telnet disabled=yes
/ip service set ftp disabled=yes
/ip service set www disabled={{ (not routeros_rfc99_gateway_http_enabled) | ternary("yes", "no") }}
/ip service set api disabled={{ (not routeros_rfc99_gateway_api_enabled) | ternary("yes", "no") }}
/ip service set winbox disabled={{ (not routeros_rfc99_gateway_winbox_enabled) | ternary("yes", "no") }} port={{ routeros_rfc99_gateway_winbox_port }} address={{ routeros_rfc99_gateway_management_cidrs | join(',') }}
/ip service set ssh disabled={{ (not routeros_rfc99_gateway_ssh_enabled) | ternary("yes", "no") }} port={{ routeros_rfc99_gateway_ssh_port }} address={{ routeros_rfc99_gateway_management_cidrs | join(',') }}
/ip ssh set strong-crypto={{ routeros_rfc99_gateway_ssh_strong_crypto | ternary("yes", "no") }} forwarding-enabled={{ routeros_rfc99_gateway_ssh_forwarding | ternary("yes", "no") }}

# Self-signed certificate until the internal CA service is wired into RouterOS imports.
/ip service set www-ssl disabled=yes address={{ routeros_rfc99_gateway_management_cidrs | join(',') }} certificate=none
/ip service set api-ssl disabled=yes address={{ routeros_rfc99_gateway_management_cidrs | join(',') }} certificate=none
/certificate remove [find name~"{{ routeros_rfc99_gateway_certificate_name }}"]
/certificate add name="{{ routeros_rfc99_gateway_certificate_name }}-template" common-name="{{ routeros_rfc99_gateway_certificate_common_name }}" subject-alt-name="{{ routeros_rfc99_gateway_certificate_subject_alt_names | join(',') }}" key-size={{ routeros_rfc99_gateway_certificate_key_size }} days-valid={{ routeros_rfc99_gateway_certificate_days_valid }} key-usage=digital-signature,key-encipherment,tls-server,key-cert-sign,crl-sign trusted=yes
/certificate sign "{{ routeros_rfc99_gateway_certificate_name }}-template" name="{{ routeros_rfc99_gateway_certificate_name }}"
:delay 2s
/ip service set www-ssl disabled={{ (not routeros_rfc99_gateway_https_enabled) | ternary("yes", "no") }} port={{ routeros_rfc99_gateway_https_port }} address={{ routeros_rfc99_gateway_management_cidrs | join(',') }} certificate={{ routeros_rfc99_gateway_certificate_name }} tls-version=only-1.2
/ip service set api-ssl disabled={{ (not routeros_rfc99_gateway_api_ssl_enabled) | ternary("yes", "no") }} port={{ routeros_rfc99_gateway_api_ssl_port }} address={{ routeros_rfc99_gateway_management_cidrs | join(',') }} certificate={{ routeros_rfc99_gateway_certificate_name }} tls-version=only-1.2

# Remote syslog client.
{% if routeros_rfc99_gateway_syslog_enabled | bool %}
/system logging remove [find where action="remote"]
/system logging remove [find where action="rfc99-remote-udp"]
/system logging action remove [find name="rfc99-remote-udp"]
/system logging action set remote remote={{ routeros_rfc99_gateway_syslog_remote_host }} remote-port={{ routeros_rfc99_gateway_syslog_remote_port_udp }} remote-protocol=udp syslog-time-format=bsd-syslog
{% for routeros_log_topic in routeros_rfc99_gateway_syslog_topics %}
/system logging add action=remote topics={{ routeros_log_topic }}
{% endfor %}
{% endif %}

# SNMP baseline. Public community is removed by default.
/snmp set enabled={{ routeros_rfc99_gateway_snmp_enabled | ternary("yes", "no") }} contact="{{ routeros_rfc99_gateway_snmp_contact }}" location="{{ routeros_rfc99_gateway_snmp_location }}"
{% if routeros_rfc99_gateway_snmp_disable_public | bool %}
:if ([:len [/snmp community find where name="public"]] > 0) do={ /snmp community set [find name="public"] disabled=yes addresses={{ routeros_rfc99_gateway_management_cidrs | join(',') }} }
{% endif %}
{% if routeros_rfc99_gateway_snmp_v2c_enabled | bool %}
/snmp community remove [find name="{{ routeros_rfc99_gateway_snmp_v2c_community }}"]
/snmp community add name="{{ routeros_rfc99_gateway_snmp_v2c_community }}" address={{ routeros_rfc99_gateway_snmp_v2c_addresses | join(',') }} read-access=yes write-access={{ routeros_rfc99_gateway_snmp_v2c_write_access | ternary("yes", "no") }} security=none
{% endif %}

# VPN scaffolds, matching CRS309 intent but leaving peers/controllers out of repo.
{% if routeros_rfc99_gateway_wireguard_enabled | bool %}
:if ([:len [/interface wireguard find where name="{{ routeros_rfc99_gateway_wireguard_interface }}"]] = 0) do={
    /interface wireguard add name="{{ routeros_rfc99_gateway_wireguard_interface }}" listen-port={{ routeros_rfc99_gateway_wireguard_listen_port }} mtu=1420 comment="RFC99 WireGuard server scaffold - add peers"
}
/ip address remove [find comment="RFC99 WireGuard server subnet"]
/ip address add address={{ routeros_rfc99_gateway_wireguard_cidr }} interface="{{ routeros_rfc99_gateway_wireguard_interface }}" comment="RFC99 WireGuard server subnet"
/interface list member add list=VPN interface="{{ routeros_rfc99_gateway_wireguard_interface }}"
{% endif %}

{% if routeros_rfc99_gateway_zerotier_scaffold_enabled | bool %}
:if ([:len [/system package find where name="zerotier"]] > 0) do={
    :log warning ("[" . $cfgTag . "] ZeroTier package present; controller/interface creation remains gated until device-mode and network ID are approved")
} else={
    :log warning ("[" . $cfgTag . "] ZeroTier package not installed - skipped")
}
{% endif %}

{% if routeros_rfc99_gateway_nat_enabled | bool %}
/ip firewall nat remove [find comment="RFC99 WAN SNAT"]
/ip firewall nat add chain=srcnat action=masquerade out-interface-list=WAN comment="RFC99 WAN SNAT"
{% endif %}

{% if routeros_rfc99_gateway_firewall_enabled | bool %}
/ip firewall filter remove [find comment~"{{ routeros_rfc99_gateway_firewall_comment_prefix }} "]
/ip firewall filter add chain=input action=accept connection-state=established,related,untracked comment="RFC99 input established"
/ip firewall filter add chain=input action=drop connection-state=invalid comment="RFC99 input invalid"
/ip firewall filter add chain=input action=accept protocol=icmp comment="RFC99 input icmp"
/ip firewall filter add chain=input action=accept in-interface-list=MGMT comment="RFC99 input mgmt"
/ip firewall filter add chain=input action=accept in-interface-list=LAN comment="RFC99 input lan"
/ip firewall filter add chain=input action=accept in-interface-list=VPN comment="RFC99 input vpn"
/ip firewall filter add chain=input action=accept in-interface-list=WAN protocol=udp dst-port=67,68 comment="RFC99 input dhcp-client"
/ip firewall filter add chain=input action=accept in-interface-list=WAN protocol=udp dst-port={{ routeros_rfc99_gateway_wireguard_listen_port }} comment="RFC99 input wireguard"
/ip firewall filter add chain=input action=drop in-interface-list=WAN comment="RFC99 input drop wan"
/ip firewall filter add chain=forward action=fasttrack-connection connection-state=established,related in-interface-list=LAN out-interface-list=WAN hw-offload=yes comment="RFC99 fasttrack lan-wan"
/ip firewall filter add chain=forward action=accept connection-state=established,related,untracked comment="RFC99 forward established"
/ip firewall filter add chain=forward action=drop connection-state=invalid comment="RFC99 forward invalid"
/ip firewall filter add chain=forward action=accept in-interface-list=LAN out-interface-list=LAN comment="RFC99 forward inter-lan"
/ip firewall filter add chain=forward action=accept in-interface-list=LAN out-interface-list=WAN comment="RFC99 forward lan-wan"
/ip firewall filter add chain=forward action=accept in-interface-list=LAN out-interface-list=VPN comment="RFC99 forward lan-vpn"
/ip firewall filter add chain=forward action=accept in-interface-list=MGMT out-interface-list=LAN comment="RFC99 forward mgmt-lan"
/ip firewall filter add chain=forward action=accept in-interface-list=MGMT out-interface-list=WAN comment="RFC99 forward mgmt-wan"
/ip firewall filter add chain=forward action=accept in-interface-list=MGMT out-interface-list=VPN comment="RFC99 forward mgmt-vpn"
/ip firewall filter add chain=forward action=accept in-interface-list=VPN out-interface-list=LAN comment="RFC99 forward vpn-lan"
/ip firewall filter add chain=forward action=accept in-interface-list=VPN out-interface-list=MGMT comment="RFC99 forward vpn-mgmt"
/ip firewall filter add chain=forward action=accept in-interface-list=WAN out-interface-list=LAN connection-nat-state=dstnat comment="RFC99 forward dstnat"
/ip firewall filter add chain=forward action=drop in-interface-list=WAN comment="RFC99 forward drop wan"
{% endif %}

:log warning ("[" . $cfgTag . "] {{ routeros_rfc99_gateway_rip_note }}")
:log info ("[" . $cfgTag . "] import complete")
