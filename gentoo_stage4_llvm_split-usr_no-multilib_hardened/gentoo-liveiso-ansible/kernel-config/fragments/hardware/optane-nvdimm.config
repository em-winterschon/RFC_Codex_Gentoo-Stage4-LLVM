# Intel Optane / NVDIMM hardware sub-profile.
# Do not include this in generic workstation kernels. Apply only when inventory
# proves NVDIMM/PMEM hardware or a storage/coherence tiering role requires it.

CONFIG_ACPI_NFIT=m
CONFIG_LIBNVDIMM=m
CONFIG_BLK_DEV_PMEM=m
CONFIG_ND_BLK=m
CONFIG_BTT=y
CONFIG_NVDIMM_PFN=y
CONFIG_NVDIMM_DAX=y
CONFIG_DEV_DAX=m
CONFIG_DEV_DAX_PMEM=m
CONFIG_DEV_DAX_HMEM=m
CONFIG_FS_DAX=y
CONFIG_DAX=y
CONFIG_X86_PMEM_LEGACY=m
