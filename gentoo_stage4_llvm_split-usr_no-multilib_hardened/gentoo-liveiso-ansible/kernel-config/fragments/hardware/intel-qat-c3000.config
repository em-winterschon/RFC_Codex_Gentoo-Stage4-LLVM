# Intel Atom C3000 / Denverton QuickAssist Technology support.
# Scope: AAEON M70 and other Intel Atom C3758 hosts with PCI ID 8086:19e2.
# Keep as a hardware subprofile; do not include in generic metal kernels.

CONFIG_PCI_IOV=y
CONFIG_UIO=m
CONFIG_UIO_PCI_GENERIC=m
CONFIG_CRYPTO_DEV_QAT=m
CONFIG_CRYPTO_DEV_QAT_C3XXX=m
CONFIG_CRYPTO_DEV_QAT_C3XXXVF=m
CONFIG_VFIO_PCI_CORE=m
CONFIG_VFIO_PCI=m
CONFIG_QAT_VFIO_PCI=m
